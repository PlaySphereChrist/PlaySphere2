# Environment Variables — PlaySphere Server
# Copy this file to server/.env and fill in your values.
# NEVER commit the actual .env file to Git.

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=playsphere
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret

# ─────────────────────────────────────────────
# Razorpay — Test Mode Only for Development
# Obtain from https://dashboard.razorpay.com/app/keys
# Never use live credentials in development.
# ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─────────────────────────────────────────────
# Client (Vite — prefix with VITE_)
# ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
